<script>
const $=s=>document.querySelector(s);

function toast(msg){
const t=$("#toast");
t.textContent=msg;
t.classList.add("show");
clearTimeout(toast.timer);
toast.timer=setTimeout(()=>t.classList.remove("show"),2300);
}

$("#themeBtn").addEventListener("click",()=>{
document.body.classList.toggle("dark");
const d=document.body.classList.contains("dark");
$("#themeBtn").textContent=d?"☀ Tema":"☾ Tema";
document.querySelector('meta[name="theme-color"]').content=d?"#18242e":"#dff1fb";
toast(d?"Dark mode diaktifkan":"Pastel mode diaktifkan");
});

$("#copyQuote").addEventListener("click",async()=>{
const q=$("#quoteText").textContent.trim();
try{
await navigator.clipboard.writeText(q);
toast("Quotes berhasil disalin ♡");
}catch(e){
const a=document.createElement("textarea");
a.value=q;
a.style.position="fixed";
a.style.opacity="0";
document.body.appendChild(a);
a.select();
const ok=document.execCommand("copy");
a.remove();
toast(ok?"Quotes berhasil disalin ♡":"Silakan salin quotes secara manual");
}
});

const input=$("#photoInput");
const grid=$("#galleryGrid");

input.addEventListener("change",()=>{
const files=Array.from(input.files||[]).filter(f=>f.type.startsWith("image/"));
if(!files.length)return;

grid.querySelector(".empty")?.remove();

files.forEach(file=>{
const url=URL.createObjectURL(file);
const tile=document.createElement("div");
const img=document.createElement("img");
const del=document.createElement("button");

tile.className="tile";
img.src=url;
img.alt=file.name||"Foto galeri Tiara";
del.type="button";
del.textContent="×";
del.setAttribute("aria-label","Hapus foto");

del.addEventListener("click",()=>{
URL.revokeObjectURL(url);
tile.remove();

if(!grid.querySelector(".tile")){
grid.innerHTML='<div class="empty"><div>📷</div><h3>Belum ada foto nih</h3><p>Tambahkan foto favoritmu lewat tombol “Tambah foto”. Kamu bisa mulai kapan aja!</p></div>';
}
});

tile.append(img,del);
grid.append(tile);
});

input.value="";
toast(files.length===1?"Foto ditambahkan ♡":files.length+" foto ditambahkan ♡");
});

document.querySelectorAll('a[href^="#"]').forEach(a=>{
a.addEventListener("click",e=>{
const target=document.querySelector(a.getAttribute("href"));
if(target){
e.preventDefault();
target.scrollIntoView({
behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"
});
}
});
});
</script>
